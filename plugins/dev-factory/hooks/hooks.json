{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/branch-guard.mjs\" claude || exit 2",
            "timeout": 10,
            "onFailure": "block",
            "statusMessage": "Checking branch policy"
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/path-guard.mjs\" bash || exit 2",
            "timeout": 10,
            "onFailure": "block",
            "statusMessage": "Checking protected files"
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/background-guard.mjs\" || exit 2",
            "timeout": 10,
            "onFailure": "block",
            "statusMessage": "Checking background commands"
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/agent-emoji.mjs\"",
            "timeout": 10,
            "statusMessage": "Tagging agent"
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/path-guard.mjs\" || exit 2",
            "timeout": 10,
            "onFailure": "block",
            "statusMessage": "Checking protected files"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/check-file.mjs\"",
            "timeout": 60,
            "statusMessage": "Linting edited file"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/verify-gate.mjs\"",
            "timeout": 300,
            "statusMessage": "Running project verify"
          }
        ]
      }
    ]
  }
}
