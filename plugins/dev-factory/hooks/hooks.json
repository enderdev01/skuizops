{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/branch-guard.mjs\" claude",
            "timeout": 10,
            "onFailure": "block",
            "statusMessage": "Checking branch policy"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/check-file.mjs\"",
            "timeout": 60,
            "statusMessage": "Linting edited file"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/verify-gate.mjs\"",
            "timeout": 300,
            "statusMessage": "Running project verify"
          }
        ]
      }
    ]
  }
}
